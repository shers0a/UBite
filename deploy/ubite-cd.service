# Continuous deployment of UBite on the UB VM (deploy/cd.sh, docs/24). Installed by deploy/install-cd.sh.
[Unit]
Description=UBite: deploy the signed image main points to
Wants=network-online.target
After=network-online.target podman-restart.service

[Service]
Type=oneshot
# Unset for system services; cosign keeps its Sigstore trust root in $HOME/.sigstore.
Environment=HOME=/root
# Without INVOCATION_ID, podman gives each container's conmon its own scope (machine.slice).
# With it, conmon stays in this service, and systemd stops the containers when the run ends.
ExecStart=/usr/bin/env -u INVOCATION_ID /opt/ubite/deploy/cd.sh
TimeoutStartSec=30min
Nice=10
