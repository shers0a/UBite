# Copy to .env and fill in. .env is gitignored; this file is committed.

# Hugging Face — free token from https://huggingface.co/settings/tokens (read scope is enough)
# Used by scripts/asset.sh for image generation (FLUX.1-schnell).
HF_TOKEN=

# Optional. Only needed if you run scripts/photo.sh with --source pexels.
# Free key from https://www.pexels.com/api/
PEXELS_KEY=

# Optional. Model override for scripts/asset.sh.
# Alternatives: stabilityai/stable-diffusion-xl-base-1.0, black-forest-labs/FLUX.1-dev
HF_MODEL=black-forest-labs/FLUX.1-schnell
