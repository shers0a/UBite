{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/brand/**",
              "components/core/**",
              "components/crowding/**",
              "components/feedback/**",
              "components/icons/**",
              "components/layout/**",
              "components/menu/**",
              "scripts/**",
              "ui_kits/dccas-dashboard/**",
              "ui_kits/kiosk/**",
              "ui_kits/staff-editor/**",
              "ui_kits/student-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo Variable))/i]",
        "message": "Font not provided by the design system. Available: Archivo Variable."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|right|brand|sticky|lang|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: title, onBack, right, brand, sticky, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ro|en)$/]",
        "message": "<AppHeader> lang must be one of 'ro' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|loading|disabled|error|fullWidth|type|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, loading, disabled, error, fullWidth, type, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|kiosk)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'kiosk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|elevation|padding|radius|as|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, elevation, padding, radius, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg|xl)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Card> radius must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|disabled|icon|count|size|onClick|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, selected, disabled, icon, count, size, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Chip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrowdingIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|waitMinutes|quality|updatedSecondsAgo|size|lang|opensAtLabel|loading|error|onReport|key|ref|className|style|children)$/]",
        "message": "<CrowdingIndicator> doesn't accept that prop. Declared props: level, waitMinutes, quality, updatedSecondsAgo, size, lang, opensAtLabel, loading, error, onReport."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrowdingIndicator'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:low|moderate|high|closed)$/]",
        "message": "<CrowdingIndicator> level must be one of 'low' | 'moderate' | 'high' | 'closed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrowdingIndicator'] > JSXAttribute[name.name='quality'] > Literal[value!=/^(?:live|degraded|estimated)$/]",
        "message": "<CrowdingIndicator> quality must be one of 'live' | 'degraded' | 'estimated'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrowdingIndicator'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|compact|kiosk)$/]",
        "message": "<CrowdingIndicator> size must be one of 'hero' | 'compact' | 'kiosk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrowdingIndicator'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ro|en)$/]",
        "message": "<CrowdingIndicator> lang must be one of 'ro' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DishDetailHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|currency|weight|tags|allergens|allergenSource|rating|ratingCount|favourite|onFavourite|onRate|slotId|photo|lang|key|ref|className|style|children)$/]",
        "message": "<DishDetailHeader> doesn't accept that prop. Declared props: name, price, currency, weight, tags, allergens, allergenSource, rating, ratingCount, favourite, onFavourite, onRate, slotId, photo, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='DishDetailHeader'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ro|en)$/]",
        "message": "<DishDetailHeader> lang must be one of 'ro' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DishRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|currency|tags|photo|slotId|glyph|portions|unavailable|loading|dense|lang|onClick|key|ref|className|style|children)$/]",
        "message": "<DishRow> doesn't accept that prop. Declared props: name, price, currency, tags, photo, slotId, glyph, portions, unavailable, loading, dense, lang, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='DishRow'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ro|en)$/]",
        "message": "<DishRow> lang must be one of 'ro' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|art|title|body|action|onAction|compact|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, art, title, body, action, onAction, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|stroke|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, stroke, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|hint|error|disabled|loading|type|suffix|icon|id|inputMode|lang|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, onChange, placeholder, hint, error, disabled, loading, type, suffix, icon, id, inputMode, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ro|en)$/]",
        "message": "<Input> lang must be one of 'ro' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|level|tone|favicon|intro|withText|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, size, level, tone, favicon, intro, withText."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tray|signal|bite|plate)$/]",
        "message": "<Logo> variant must be one of 'tray' | 'signal' | 'bite' | 'plate'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:low|moderate|high|closed)$/]",
        "message": "<Logo> level must be one of 'low' | 'moderate' | 'high' | 'closed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|mono|inverse|level)$/]",
        "message": "<Logo> tone must be one of 'accent' | 'mono' | 'inverse' | 'level'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingStars'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|count|size|interactive|onRate|pending|disabled|lang|key|ref|className|style|children)$/]",
        "message": "<RatingStars> doesn't accept that prop. Declared props: value, count, size, interactive, onRate, pending, disabled, lang."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingStars'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ro|en)$/]",
        "message": "<RatingStars> lang must be one of 'ro' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|tone|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, variant, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|mark|inline)$/]",
        "message": "<Wordmark> variant must be one of 'full' | 'mark' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|mono|inverse)$/]",
        "message": "<Wordmark> tone must be one of 'accent' | 'mono' | 'inverse'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
