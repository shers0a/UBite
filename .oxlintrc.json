{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error",
    "react-hooks/exhaustive-deps": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/ubite-design/components/**"
            ],
            "message": "Import design-system components from '@ds' (its index.js), not component internals."
          }
        ]
      }
    ],
    "react/set-state-in-effect": "off",
    "react/purity": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/memo-dependencies": "off",
    "import/no-unassigned-import": "off",
    "import/no-named-as-default": "off",
    "no-underscore-dangle": "off",
    "no-shadow": "off"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "apps/api/.data/**"
  ]
}