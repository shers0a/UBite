# Copy to .env and fill in. .env is gitignored; this file is committed.
# scripts/asset.mjs tries the providers in ASSET_PROVIDERS order and falls back
# to the next one when a key is missing or the free quota is used up.

# Cloudflare Workers AI — free, ~100+ FLUX images a day.
# Account ID: dash.cloudflare.com → any page, right sidebar ("Account ID") or the URL.
# Token: dash.cloudflare.com/profile/api-tokens → Create Token → "Workers AI" template.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Hugging Face — free tier is small ($0.10/month), used as fallback.
# huggingface.co/settings/tokens → Create new token → Fine-grained →
# tick "Make calls to Inference Providers".
HF_TOKEN=

# Pollinations — free key at https://enter.pollinations.ai/keys (GitHub login). Daily "pollen"
# covers FLUX.1-schnell, Z-Image, FLUX.2 klein, GPT-Image and the Nova Reel video model.
POLLINATIONS_KEY=

# AI Horde — works with no key (anonymous, slowest queue). A free key from
# https://aihorde.net/register moves you up the queue.
HORDE_KEY=

# Order in which providers are tried. "space" = the free FLUX.1-schnell Hugging Face Space
# (no daily neuron limit, ~10s an image), the fallback when Cloudflare runs out for the day.
# Local, unlimited: ComfyUI + FLUX.2 [klein] 4B on this machine's GPU (npm run ai:start).
# COMFY_DIR is the ComfyUI portable folder; COMFY_URL where it listens.
COMFY_DIR=C:/AI/ComfyUI_windows_portable
COMFY_URL=http://127.0.0.1:8188
ASSET_PROVIDERS=comfy,cloudflare,pollinations,space,horde,hf

# Optional model overrides.
CF_MODEL=@cf/black-forest-labs/flux-2-klein-9b
HF_MODEL=black-forest-labs/FLUX.1-schnell

# ══ The application (apps/api) — docs/12 "Configuration" ════════════════════════════════════
# Every variable the app reads, without values. Production refuses to start with the defaults.

NODE_ENV=production
PORT=8080
# postgres://user:password@host:5432/ubite — or pglite:.data/pglite for a laptop without Docker.
DATABASE_URL=
# The public address students open; the kiosk QR points here (with ?src=kiosk).
PUBLIC_URL=https://ubite.unibuc.ro
# Long random string: signs receipt drafts and code hashes. `openssl rand -hex 32`
SESSION_SECRET=
# How many proxies sit in front of the app (Caddy in docker-compose.prod.yml = 1).
TRUST_PROXY=1
LOG_LEVEL=info

# Sign-in codes and alerts. Any SMTP provider: smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=UBite <no-reply@ubite.unibuc.ro>
# Who acts on "no menu by 10:00" and "camera silent" (docs/12: a named person). Comma-separated.
ALERT_EMAILS=

# Web push. Generate once: npm run cli -w @ubite/api -- vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ubite@unibuc.ro

# Tokens the vision service may post with; comma-separated so a rotation can overlap.
VISION_TOKENS=

# Feature flags (docs/12). Loyalty waits for DCCAS in writing; the soft variant works without it.
FEATURE_CAMERA=false
FEATURE_LOYALTY=true
FEATURE_WASTE=false
FEATURE_PREDICTION=true

# The canteen's fiscal code(s), digits only, comma-separated: only its receipts count (docs/09).
# Empty accepts any shop's receipt — fill it in from the first real receipt (docs/17 D6).
RECEIPT_FISCAL_CODES=

# Accounts created on start, so someone can sign in to the staff tools. Comma-separated emails.
BOOTSTRAP_TECH_ADMINS=
BOOTSTRAP_CANTEEN_STAFF=
BOOTSTRAP_DCCAS=

# Privacy page (docs/11): filled in once UB confirms; until then the page says it is a draft.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT_EMAIL=
PRIVACY_DPO_EMAIL=
PRIVACY_APPROVED=false

# docker-compose.prod.yml
DOMAIN=ubite.unibuc.ro
# Other addresses that get a certificate and redirect to DOMAIN, space-separated (optional).
DOMAIN_ALIASES=
POSTGRES_PASSWORD=
# Only with the `camera` profile: the camera's RTSP address and one of VISION_TOKENS.
CAMERA_RTSP_URL=
VISION_TOKEN=

# Development only — never in production.
DEV_LOG_CODES=false
